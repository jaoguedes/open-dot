{
  "name": "open-dot",
  "version": "0.1.0",
  "private": true,
  "description": "Open Dot — assistente pessoal com agentes, rotinas remotas e o mascote Dot.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/dev.ts --demo",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx \"packages/**/test/*.test.ts\" \"apps/**/test/*.test.ts\" \"tests/*.test.ts\"",
    "test:ui": "node scripts/ui-check.mjs",
    "check": "npm run typecheck && npm test && npm run eval:correio && npm run test:blender && npm run build",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "turso:inspect": "tsx scripts/turso-inspect.ts",
    "secrets:keygen": "node scripts/keygen.mjs",
    "blender:check": "python3 blender/run_blender.py preflight",
    "blender:build": "python3 blender/run_blender.py build",
    "worker:deploy": "npm run check && npm run test:workerd && npx --yes wrangler@4 deploy",
    "worker:dev": "npx --yes wrangler@4 dev --local --port 8799",
    "test:workerd": "tsx scripts/check-workerd-health.ts",
    "ui:mobile": "node scripts/ui-mobile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "setup:cloud": "tsx scripts/setup-cloud.ts",
    "test:blender": "python3 blender/test_spec.py",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "ui:fase-a": "node scripts/ui-fase-a.mjs",
    "ui:fase-d": "node scripts/ui-fase-d.mjs",
    "icons": "node scripts/icons/make-ico.mjs",
    "ui:fase-e": "node scripts/ui-fase-e.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:fase-f": "node scripts/ui-fase-f.mjs",
    "eval:correio": "tsx scripts/eval-correio.ts",
    "ui:fase-g": "node scripts/ui-fase-g.mjs",
    "ui:rodada4": "node scripts/ui-rodada4.mjs",
    "runner:build": "node scripts/build-runner.mjs",
    "runner:desktop": "cd apps/runner && tauri",
    "ui:runner": "node scripts/ui-runner.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
