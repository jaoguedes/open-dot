# Open Dot — modelo de configuração (SEM SEGREDOS).
# Local: copie as linhas necessárias para .dev.vars (não versionado; o `npm run dev` cria um básico).
# Produção (Cloudflare): `npx wrangler secret put NOME` para cada segredo marcado [segredo].

APP_ENV=development
APP_ORIGIN=http://localhost:8787
# [segredo] Chave de cifra dos tokens. Gere com: npm run secrets:keygen
TOKEN_KEYS=
SESSION_DAYS=30

# Turso — banco SEPARADO só do Open Dot (ex.: libsql://open-dot-<org>.turso.io)
TURSO_DATABASE_URL=
# [segredo] token do banco (turso db tokens create open-dot)
TURSO_AUTH_TOKEN=

# Google (login + Gmail leitura) — cliente OAuth tipo "Aplicativo da Web"
GOOGLE_CLIENT_ID=
# [segredo]
GOOGLE_CLIENT_SECRET=
# Dono único: seu e-mail Google verificado. Opcional: OWNER_GOOGLE_SUB fixa pela identidade estável do Google.
OWNER_EMAIL=
OWNER_GOOGLE_SUB=

# GitHub App (leitura) — opcional nesta fase
# [segredo]
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# [segredo] chave privada .pem (conteúdo inteiro)
GITHUB_APP_PRIVATE_KEY=

# Vercel (leitura de deployments) — opcional
# [segredo] token com escopo só no time/projeto necessário
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Finnhub Free — só ações (PETR4.SA). Sem chave, cripto (CoinGecko) e câmbio (Frankfurter) continuam.
# [segredo] cadastre em https://finnhub.io (plano gratuito). Nunca cole no chat; use setup:cloud ou .dev.vars.
FINNHUB_API_KEY=

# IA (Groq Free). Sem chave → resumos por regras.
# [segredo]
GROQ_API_KEY=
# Só "true" depois de ativar Zero Data Retention no console da Groq (libera e-mail privado para a IA)
GROQ_ZDR_CONFIRMED=false
AI_CALLS_PER_DAY=50
AI_TOKENS_PER_DAY=100000

# Blender (só na sua máquina; também pode ir em blender/.blender-path)
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
