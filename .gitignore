# Dependências e builds
node_modules/
dist/
apps/web/dist/
.wrangler/
coverage/
test-results/

# Configuração privada — nunca versionar
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
# Instância de destino do deploy (origem e nome do dono), por máquina
.deploy.local.json
*.pem
*.key

# Banco local de desenvolvimento
.data/

# Blender: saídas geradas e backups automáticos
blender/out/
*.blend1
*.blend2

# Sistema
.DS_Store
Thumbs.db

# Caminho local do Blender (por máquina)
blender/.blender-path

# Referências grandes/privadas (PDF do projeto) ficam só na máquina
docs/referencias/*.pdf

# Python
__pycache__/
*.pyc

# Pacotes de sincronização
.sync/

# Runner desktop
apps/runner/src-tauri/target/
apps/runner/src-tauri/gen/
apps/runner/installers/

# Local cooperative shared-state write protocol (never commit transient locks)
docs/audit/ENGINEERING_STATE.json.lock
docs/audit/.agent-state-*.tmp

# Anotações pessoais do mantenedor (contas, produção). Ficam só na máquina.
docs/privado/

# Termos pessoais procurados pelo scanner (handle, subdomínio). Só local.
.pii-terms.local
