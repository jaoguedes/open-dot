{
  "type": "object",
  "additionalProperties": false,
  "required": ["pergunta", "criterios", "referencias", "comparacao", "recomendacao"],
  "properties": {
    "pergunta": { "type": "string", "maxLength": 400 },
    "criterios": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "maxLength": 120 } },
    "referencias": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["url", "acesso", "anotacao", "classe"], "properties": {
      "url": { "type": "string", "pattern": "^https://", "maxLength": 400 },
      "acesso": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "anotacao": { "type": "string", "maxLength": 500 },
      "classe": { "enum": ["fato_verificado", "declarado_pelo_fabricante", "opiniao", "nao_verificado"] },
      "licenca": { "type": ["string", "null"], "maxLength": 60 },
      "alerta_de_injecao": { "type": ["string", "null"], "maxLength": 300 } } } },
    "comparacao": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["opcao", "valores"], "properties": { "opcao": { "type": "string", "maxLength": 80 }, "valores": { "type": "object", "additionalProperties": { "type": ["string", "null"], "maxLength": 200 } } } } },
    "recomendacao": { "type": "string", "maxLength": 800 }
  }
}
