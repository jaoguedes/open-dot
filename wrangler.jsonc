// Cloudflare Worker do Open Dot: interface estática + API + cron, no plano Free.
// Segredos NÃO ficam aqui: use `npx wrangler secret put NOME` (lista em .env.example).
{
  "name": "open-dot",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/*", "/chunks/*"]
  },
  // Um único Cron Trigger (Free permite 5 por conta). Horário em UTC; o código converte 08h/17h America/Sao_Paulo.
  "triggers": { "crons": ["*/5 * * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "APP_ENV": "production",
    // Troque <SEU-SUBDOMINIO> pelo subdomínio workers.dev da sua conta antes do primeiro deploy.
    "APP_ORIGIN": "https://open-dot.jpguedesbarbieri.workers.dev",
    // Nome mostrado na saudação até o dono salvar outro em Configurações.
    "OWNER_NAME": "João",
    "SESSION_DAYS": "30",
    "AI_CALLS_PER_DAY": "50",
    "AI_TOKENS_PER_DAY": "100000",
    "GROQ_ZDR_CONFIRMED": "false",
    "PACOTEVICIO_TERMS_CONFIRMED": "false"
  }
}
